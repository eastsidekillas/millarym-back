# Скопировать в .env и заполнить. .env в git не коммитить.

# dev — локальная разработка, prod — сервер (в docker-compose задаётся там)
DJANGO_ENV=dev
DJANGO_SECRET_KEY=сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(50))"
DEBUG=True

# Через запятую: адрес сервера в локальной сети и/или домен
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:4200
CSRF_TRUSTED_ORIGINS=http://localhost:4200

# PostgreSQL (для локального запуска без Docker — поднять postgres из docker-compose)
DATABASE_ENGINE=django.db.backends.postgresql
DATABASE_NAME=millarym
DATABASE_USER=millarym
DATABASE_PASSWORD=millarym
DATABASE_HOST=localhost
DATABASE_PORT=5432

MEDIA_ROOT=media
MEDIA_URL=/media/

# Токены в cookie: доступ — часы, обновление — дни
ACCESS_TOKEN_LIFETIME=8
REFRESH_TOKEN_LIFETIME=14
# True, когда сайт работает по HTTPS. Для HTTP в локальной сети — False
COOKIE_SECURE=False

# Защита от подбора пароля. Пока CRM только в локальной сети — False.
# Включить (True), когда откроем доступ из интернета: N попыток → блокировка на M минут
AXES_ENABLED=False
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_MINUTES=15
